#include <windows.h>
#include "resource.h"

IDI_FACELOGIN_DIAG ICON "..\\assets\\facelogin.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,1,0,0
PRODUCTVERSION  2,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "FaceLogin"
            VALUE "FileDescription", "FaceLogin Diagnostic"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "FaceLoginDiag.exe"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "FaceLoginDiag.exe"
            VALUE "ProductName", "FaceLogin"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
